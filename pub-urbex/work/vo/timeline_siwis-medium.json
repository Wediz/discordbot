{
 "lines": [
  {
   "t0": 2.5,
   "t1": 5.009,
   "text": "Un jour, quelqu'un a fermé la porte."
  },
  {
   "t0": 5.509,
   "t1": 7.45,
   "text": "Et personne ne l'a jamais rouverte."
  },
  {
   "t0": 8.65,
   "t1": 10.776,
   "text": "Depuis, le temps travaille seul."
  },
  {
   "t0": 11.776,
   "t1": 13.389,
   "text": "La lumière entre par les toits."
  },
  {
   "t0": 14.289,
   "t1": 16.094,
   "text": "Les arbres traversent les murs."
  },
  {
   "t0": 16.994,
   "t1": 18.26,
   "text": "Les pianos se sont tus."
  },
  {
   "t0": 19.36,
   "t1": 20.65,
   "text": "Mais tout est encore là."
  },
  {
   "t0": 21.95,
   "t1": 26.516,
   "text": "Des châteaux. Des sanatoriums. Des forts. Des usines."
  },
  {
   "t0": 27.416,
   "t1": 29.896,
   "text": "Des histoires que plus personne ne raconte."
  },
  {
   "t0": 30.796,
   "t1": 32.274,
   "text": "Sauf ceux qui osent entrer."
  },
  {
   "t0": 33.674,
   "t1": 37.252,
   "text": "Ne prenez que des photos. Ne laissez aucune trace."
  },
  {
   "t0": 38.552,
   "t1": 42.165,
   "text": "URBEX-FRANCE.COM — La carte des lieux abandonnés."
  },
  {
   "t0": 43.165,
   "t1": 44.591,
   "text": "Le monde d'avant vous attend."
  }
 ],
 "vo_end": 44.591
}