{
 "lines": [
  {
   "t0": 2.2,
   "t1": 3.716,
   "text": "Vous ne verrez jamais mon visage."
  },
  {
   "t0": 4.616,
   "t1": 7.769,
   "text": "Depuis des années, j'entre là où personne ne va."
  },
  {
   "t0": 8.269,
   "t1": 10.563,
   "text": "Des lieux oubliés, partout en Europe."
  },
  {
   "t0": 10.913,
   "t1": 13.41,
   "text": "Des endroits dont vous ignorez l'existence."
  },
  {
   "t0": 14.21,
   "t1": 16.584,
   "text": "Jusqu'ici, je gardais tout pour moi."
  },
  {
   "t0": 17.134,
   "t1": 17.895,
   "text": "C'est terminé."
  },
  {
   "t0": 18.895,
   "t1": 26.235,
   "text": "Bientôt, je vous emmène. En POV. Sans un mot."
  },
  {
   "t0": 27.035,
   "t1": 28.689,
   "text": "Juste l'infiltration."
  },
  {
   "t0": 29.039,
   "t1": 29.768,
   "text": "Les courses."
  },
  {
   "t0": 30.118,
   "t1": 30.773,
   "text": "Les poursuites."
  },
  {
   "t0": 31.773,
   "t1": 36.602,
   "text": "La première vidéo arrive."
  },
  {
   "t0": 37.202,
   "t1": 40.275,
   "text": "Abonnez-vous. Pour être là quand la porte s'ouvre."
  },
  {
   "t0": 41.175,
   "t1": 42.13,
   "text": "NØTRACE."
  }
 ],
